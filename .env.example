# ── Gemini / Google GenAI ─────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Composio ─────────────────────────────────────────────────────────────
COMPOSIO_API_KEY=

# ── Optional: Serper / Tavily for web search tool ────────────────────────
SERPER_API_KEY=
TAVILY_API_KEY=

# ── Pipeline tuning ──────────────────────────────────────────────────────────
# Number of parallel workers in batch.py (default: 5)
BATCH_CONCURRENCY=5
# Model to use for the research agent
RESEARCH_MODEL=gemini-2.0-flash
# Max concurrent Gemini API calls (default 3; raise for paid keys with higher RPM)
GEMINI_API_CONCURRENCY=3
# NOTE: gemini-3.1-pro-preview has 0 daily requests on the free tier.
# Pro escalation will fall back gracefully to flash results in that case.
# Upgrade to a paid Gemini API plan to enable pro escalation.
